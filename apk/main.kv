#:import Gauge gauge.Gauge

<GaugeCell@FloatLayout>:
    gauge_value: 0
    gauge_max: 100
    arc_rgba: [0.07, 0.69, 0.07, 1]
    big_rgba: [1, 1, 1, 1]
    title_text: ''
    big_text: '0'
    caption_text: ''
    Gauge:
        value: root.gauge_value
        max_value: root.gauge_max
        arc_color: root.arc_rgba
        size_hint: 1, 1
        pos: root.pos
        size: root.size
    Label:
        text: root.title_text
        markup: True
        bold: True
        font_size: 26
        color: 0.65, 0.65, 0.65, 1
        size_hint: 1, None
        height: 30
        pos_hint: {'center_x': 0.5, 'center_y': 0.93}
    Label:
        text: root.big_text
        markup: True
        bold: True
        font_size: 52
        color: root.big_rgba
        halign: 'center'
        size_hint: 1, None
        height: 60
        pos_hint: {'center_x': 0.5, 'center_y': 0.47}
    Label:
        text: root.caption_text
        markup: True
        font_size: 24
        color: 0.8, 0.8, 0.8, 1
        halign: 'center'
        size_hint: 1, None
        height: 28
        pos_hint: {'center_x': 0.5, 'center_y': 0.18}

BoxLayout:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
    orientation: 'vertical'
    Image:
        source: 'assets/banner.png'
        size_hint_y: 0.6
    Label:
        id: ssid_label
        font_size: 44
        text: ''
        bold: True
        markup: True
        size_hint_y: 0.5
        pos_hint: {'center_x': .5, 'center_y': 1}
        background_color: [0, 0, 0, 0]
    BoxLayout:
        id: gauge_panel
        orientation: 'horizontal'
        size_hint_y: 1.6
        padding: 10
        spacing: 6
        GaugeCell:
            id: cell_tx
            title_text: 'ARP Tx'
            arc_rgba: [0.30, 0.31, 1.0, 1]
            big_rgba: [0.30, 0.31, 1.0, 1]
            big_text: '0'
            caption_text: 'pkt/s'
        GaugeCell:
            id: cell_surv
            title_text: 'SURVIVING'
            arc_rgba: [0.07, 0.69, 0.07, 1]
            big_rgba: [0.07, 0.69, 0.07, 1]
            big_text: '--'
            caption_text: 'idle'
        GaugeCell:
            id: cell_evid
            title_text: 'ARP Rx + evidence'
            arc_rgba: [0.90, 0.85, 0.0, 1]
            big_rgba: [0.90, 0.85, 0.0, 1]
            big_text: '0'
            caption_text: 'pkt/s'
    Label:
        text: ''
        bold: True
        markup: True
        size_hint_y: 0.7
        pos_hint: {'center_x': .5, 'center_y': 1}
        id: output_label
    GridLayout:
        cols: 3
        padding: 20
        size_hint_y: 0.9
        Button:
            text: '[color=#11B011][b]Start[/color][/b]'
            font_size: 55
            markup: True
            size_hint: (0.25, None)
            height: 180
            pos_hint: {'center_x': .5, 'center_y': .5}
            background_color: [0, 0, 0, 0]
            on_press: app.on_start_press()
            canvas.before:
                Color:
                    rgba: 1,1,1,0.03
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [(30,30), (0,0), (0,0), (30,30)]
        Button:
            text: '[color=#0077CC][b]Refresh[/color][/b]'
            font_size: 55
            markup: True
            size_hint: (0.25, None)
            height: 180
            pos_hint: {'center_x': .5, 'center_y': .5}
            background_color: [0, 0, 0, 0]
            on_press: app.on_refresh_press()
            canvas.before:
                Color:
                    rgba: 1,1,1,0.03
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0]
        Button:
            text: '[color=#D10000][b]Stop[/color][/b]'
            font_size: 55
            markup: True
            size_hint: (0.25, None)
            height: 180
            pos_hint: {'center_x': .5, 'center_y': .5}
            background_color: [0, 0, 0, 0]
            on_press: app.on_stop_press()
            canvas.before:
                Color:
                    rgba: 1,1,1,0.03
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [(0,0), (30,30), (30,30), (0,0)]
    BoxLayout:
        size_hint_y: None
        height: 90
        padding: [33, 10]
        Button:
            text: '[color=#FFFFFF][b]Debug Logs[/b][/color]'
            font_size: 26
            markup: True
            size_hint: (1, 1)
            background_color: [0, 0, 0, 0]
            on_press: app.on_debug_press()
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]
    Label:
        text: 'written by [color=#4D4FFF][u][ref=https://github.com/flashnuke]@flashnuke[/ref][/color][/u]'
        bold: True
        markup: True
        size_hint_y: 0.4
        pos_hint: {'center_x': .5, 'center_y': 1}
        on_ref_press: app.on_ref_credit_press()
