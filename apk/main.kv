#:import Gauge gauge.Gauge
#:import Spinner kivy.uix.spinner.Spinner

# DeadNet v3 — own-the-PHY UI: Recon / Select / Attack.
# Sizes carried over from the prior layout (owner: "bigger by ~35%").

# ---- reusable gauge cell -----------------------------------------------------
<GaugeCell@FloatLayout>:
    gauge_value: 0
    gauge_max: 100
    arc_rgba: [0.07, 0.69, 0.07, 1]
    big_rgba: [1, 1, 1, 1]
    title_text: ''
    big_text: '0'
    caption_text: ''
    Gauge:
        value: root.gauge_value
        max_value: root.gauge_max
        arc_color: root.arc_rgba
        size_hint: 1, 1
        pos: root.pos
        size: root.size
    Label:
        text: root.title_text
        markup: True
        bold: True
        font_size: 30
        color: 0.65, 0.65, 0.65, 1
        size_hint: 1, None
        height: 35
        pos_hint: {'center_x': 0.5, 'center_y': 0.93}
    Label:
        text: root.big_text
        markup: True
        bold: True
        font_size: 59
        color: root.big_rgba
        halign: 'center'
        size_hint: 1, None
        height: 73
        pos_hint: {'center_x': 0.5, 'center_y': 0.47}
    Label:
        text: root.caption_text
        markup: True
        font_size: 27
        color: 0.8, 0.8, 0.8, 1
        halign: 'center'
        size_hint: 1, None
        height: 32
        pos_hint: {'center_x': 0.5, 'center_y': 0.18}

<PresetButton@Button>:
    accent: [0.30, 0.31, 1.0, 1]
    markup: True
    font_size: 40
    halign: 'center'
    background_color: [0, 0, 0, 0]
    canvas.before:
        Color:
            rgba: root.accent if self.state == 'normal' else [root.accent[0], root.accent[1], root.accent[2], 0.5]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [24]

<NavButton@Button>:
    markup: True
    font_size: 30
    background_color: [0, 0, 0, 0]
    color: 0.85, 0.85, 0.85, 1
    canvas.before:
        Color:
            rgba: 0.12, 0.12, 0.14, 1
        Rectangle:
            pos: self.pos
            size: self.size

# =============================================================================
BoxLayout:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # persistent status strip
    Label:
        id: status_bar
        text: 'ANDROID — PHY not owned'
        markup: True
        font_size: 22
        color: 0.75, 0.8, 0.95, 1
        size_hint_y: None
        height: 40

    ScreenManager:
        id: sm
        size_hint_y: 1

        # ---------------------------------------- §1 RECON (own PHY + detect)
        Screen:
            name: 'recon'
            BoxLayout:
                orientation: 'vertical'
                padding: 22
                spacing: 11
                Label:
                    text: '[b]RECON[/b]'
                    markup: True
                    font_size: 40
                    size_hint_y: None
                    height: 60
                BoxLayout:
                    size_hint_y: None
                    height: 112
                    spacing: 12
                    PresetButton:
                        id: btn_own
                        text: '[b]OWN PHY[/b]'
                        accent: [0.30, 0.31, 1.0, 1]
                        on_press: app.on_own()
                    PresetButton:
                        id: btn_release
                        text: '[b]RELEASE[/b]'
                        accent: [0.25, 0.25, 0.25, 1]
                        on_press: app.on_release()
                BoxLayout:
                    size_hint_y: None
                    height: 60
                    spacing: 12
                    Label:
                        id: recon_count
                        text: 'targets: 0'
                        markup: True
                        font_size: 26
                    Button:
                        text: '[b]CapGate[/b]'
                        markup: True
                        font_size: 24
                        size_hint_x: None
                        width: 190
                        on_press: app.on_capgate()
                    Button:
                        text: '[b]Clear[/b]'
                        markup: True
                        font_size: 24
                        size_hint_x: None
                        width: 150
                        on_press: app.on_clear_targets()
                ScrollView:
                    size_hint_y: 1
                    GridLayout:
                        id: target_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: 5
                        padding: [0, 5]

        # ---------------------------------------- §2 SELECT (pick targets)
        Screen:
            name: 'select'
            BoxLayout:
                orientation: 'vertical'
                padding: 20
                spacing: 11
                Label:
                    text: '[b]SELECT[/b]'
                    markup: True
                    font_size: 40
                    size_hint_y: None
                    height: 58
                BoxLayout:
                    size_hint_y: None
                    height: 76
                    spacing: 10
                    TextInput:
                        id: sel_input
                        hint_text: '3  |  1,3  |  Shome*  |  S~^OH  |  all'
                        multiline: False
                        font_size: 26
                        on_text_validate: app.on_apply_selection(self.text)
                    Button:
                        text: '[b]Apply[/b]'
                        markup: True
                        font_size: 26
                        size_hint_x: None
                        width: 150
                        on_press: app.on_apply_selection(sel_input.text)
                BoxLayout:
                    size_hint_y: None
                    height: 60
                    spacing: 10
                    Label:
                        id: sel_count
                        text: 'selected: 0'
                        markup: True
                        font_size: 28
                    Button:
                        text: '[b]all[/b]'
                        markup: True
                        font_size: 24
                        size_hint_x: None
                        width: 120
                        on_press: app.on_apply_selection('all')
                    Button:
                        text: '[b]clear[/b]'
                        markup: True
                        font_size: 24
                        size_hint_x: None
                        width: 130
                        on_press: app.on_clear_selection()
                ScrollView:
                    size_hint_y: 1
                    GridLayout:
                        id: sel_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: 5
                        padding: [0, 5]

        # ---------------------------------------- §3 ATTACK (mgmt-TX)
        Screen:
            name: 'attack'
            BoxLayout:
                orientation: 'vertical'
                padding: 16
                spacing: 7
                Label:
                    text: '[b]ATTACK[/b]'
                    markup: True
                    font_size: 36
                    size_hint_y: None
                    height: 46
                Spinner:
                    id: mode_spinner
                    text: 'deauth (broadcast, from AP)'
                    font_size: 22
                    size_hint_y: None
                    height: 64
                    on_text: app.on_mode_pick(self.text)
                Label:
                    id: mode_desc
                    text: ''
                    markup: True
                    font_size: 18
                    color: 0.62, 0.66, 0.78, 1
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: 52
                    text_size: self.width, None
                # per-action knobs — populated by main.py from the mode's knob set
                BoxLayout:
                    id: knob_panel
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 6
                BoxLayout:
                    size_hint_y: None
                    height: 74
                    spacing: 12
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'pps'
                            font_size: 17
                            size_hint_y: None
                            height: 20
                        TextInput:
                            id: pps_input
                            text: '100'
                            multiline: False
                            input_filter: 'int'
                            font_size: 24
                            on_text_validate: app.on_pps(self.text)
                            on_focus: app.on_pps(self.text) if not self.focus else None
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'burst  (0 = until STOP)'
                            font_size: 17
                            size_hint_y: None
                            height: 20
                        TextInput:
                            id: budget_input
                            text: '0'
                            multiline: False
                            input_filter: 'int'
                            font_size: 24
                            on_text_validate: app.on_budget(self.text)
                            on_focus: app.on_budget(self.text) if not self.focus else None
                Widget:
                    size_hint_y: 1
                BoxLayout:
                    id: gauge_panel
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 300
                    spacing: 10
                    GaugeCell:
                        id: cell_acc
                        title_text: 'ACCEPTED'
                        arc_rgba: [0.07, 0.69, 0.07, 1]
                        big_rgba: [0.07, 0.69, 0.07, 1]
                        big_text: '0'
                        caption_text: 'of sent'
                    GaugeCell:
                        id: cell_rate
                        title_text: 'RATE'
                        arc_rgba: [0.30, 0.31, 1.0, 1]
                        big_rgba: [0.30, 0.31, 1.0, 1]
                        big_text: '0'
                        caption_text: 'pps'
                Widget:
                    size_hint_y: 1
                Label:
                    id: attack_status
                    text: 'select targets on RECON/SELECT, then FIRE'
                    markup: True
                    font_size: 21
                    color: 0.7, 0.7, 0.7, 1
                    size_hint_y: None
                    height: 38
                BoxLayout:
                    size_hint_y: None
                    height: 112
                    spacing: 16
                    padding: [5, 8]
                    PresetButton:
                        id: btn_fire
                        text: '[b]FIRE[/b]'
                        accent: [0.82, 0.11, 0.11, 1]
                        on_press: app.on_fire()
                    PresetButton:
                        id: btn_stop
                        text: '[b]STOP[/b]'
                        accent: [0.25, 0.25, 0.25, 1]
                        on_press: app.on_stop()

    # ---- persistent bottom nav -------------------------------------------
    BoxLayout:
        size_hint_y: None
        height: 92
        NavButton:
            text: '[b]Recon[/b]'
            on_press: app.goto('recon')
        NavButton:
            text: '[b]Select[/b]'
            on_press: app.goto('select')
        NavButton:
            text: '[b]Attack[/b]'
            on_press: app.goto('attack')
